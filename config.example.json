{
  "port": 7889,
  "host": "127.0.0.1",
  "providers": [
    {
      "name": "zhipu",
      "tier": "free",
      "base": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
      "model": "glm-4-flash",
      "key": "",
      "env": "ZHIPU_API_KEY",
      "applyUrl": "https://open.bigmodel.cn/usercenter/apikeys",
      "price_in": 0,
      "price_out": 0,
      "freeQuota": {
        "amount": 2000000,
        "unit": "token",
        "reset": "day"
      },
      "note": "智谱 GLM-4-Flash：有免费额度，新手先用这家。key 去 applyUrl 拿（注册→API Keys→复制）；tier=free 会走额度闸门（见 docs/额度策略.md）"
    },
    {
      "name": "deepseek",
      "tier": "cloud",
      "base": "https://api.deepseek.com/chat/completions",
      "model": "deepseek-chat",
      "key": "",
      "env": "DEEPSEEK_API_KEY",
      "applyUrl": "https://platform.deepseek.com/api_keys",
      "price_in": 2,
      "price_out": 8,
      "note": "DeepSeek：key 去 applyUrl 拿（注册→API keys→创建）。单价是元/百万 token，用来估账本，不是账单",
      "tools": true
    },
    {
      "name": "siliconflow",
      "tier": "free",
      "base": "https://api.siliconflow.cn/v1/chat/completions",
      "model": "Qwen/Qwen2.5-7B-Instruct",
      "key": "",
      "env": "SILICONFLOW_API_KEY",
      "applyUrl": "https://cloud.siliconflow.cn/account/ak",
      "price_in": 0,
      "price_out": 0,
      "note": "硅基流动：key 去 applyUrl 拿；这个模型有免费额度，走额度闸门，429 会自动跳过换下一家"
    },
    {
      "name": "ollama-8b",
      "tier": "local",
      "base": "http://127.0.0.1:11434/v1/chat/completions",
      "model": "qwen3:8b",
      "key": "local",
      "price_in": 0,
      "price_out": 0,
      "applyUrl": "https://ollama.com/download",
      "note": "本机 Ollama：不用填 key，但要先装 Ollama 并 ollama pull qwen3:8b；没装就当它不存在"
    }
  ],
  "route": {
    "mode": "cloud-first",
    "order": [
      "zhipu",
      "deepseek",
      "siliconflow",
      "ollama-8b"
    ],
    "escalate": true,
    "maxSteps": 20
  },
  "quotaSources": [
    {
      "provider": "zhipu",
      "url": ""
    }
  ],
  "quotaSourcesNote": "可选。填公开的额度说明页地址（不需要登录的那种），定期抓页面文本刷新对应 provider 的 freeQuota；url 留空或抓不到就保留旧值，不清空。不填就不刷新规则，只靠账本 + 探测。详见 docs/额度策略.md",
  "memory": {
    "topK": 10,
    "maxHistory": 20,
    "autoCapture": true,
    "writeEvents": true,
    "eventWindowDays": 7,
    "idleConsolidateMinutes": 60,
    "consolidate": {
      "dupThreshold": 0.85,
      "oldEventDays": 60,
      "minGroup": 4
    },
    "summaryTrigger": 40,
    "summaryKeep": 20
  },
  "embedding": {
    "enabled": false,
    "base": "https://open.bigmodel.cn/api/paas/v4/embeddings",
    "model": "embedding-3",
    "key": "",
    "note": "填了 key 并 enabled=true 才走向量召回；不填就纯关键词，功能不残"
  },
  "tools": {
    "workspace": "data/workspace",
    "allowCommand": true,
    "commandWhitelist": [
      "echo",
      "dir",
      "type",
      "node",
      "python",
      "git",
      "where",
      "ls",
      "cat",
      "findstr",
      "more"
    ],
    "commandTimeoutMs": 30000,
    "maxOutput": 12000,
    "names": null
  },
  "sandbox": {
    "mode": "none",
    "image": "node:22-alpine",
    "note": "none=直接执行（默认）/ process=子进程+临时目录+超时 / docker=容器内，探测不到 docker 会报错并回退 process"
  },
  "qq": {
    "enabled": false,
    "gateway": "",
    "token": "",
    "allow": [],
    "groups": [],
    "self_id": "",
    "note": "可选，默认关。gateway 是 OneBot HTTP 地址（如 http://127.0.0.1:5700）；allow 是允许私聊的 QQ 号；groups 是允许的群号；群里必须 @ 她或点名才回。"
  },
  "budget": {
    "perCallSeconds": 120,
    "perTaskSeconds": 180,
    "perTaskTokens": 200000,
    "dailyCostCapCNY": 2
  },
  "temperature": 0.7,
  "persona": "",
  "personaNote": "留空 = 用内置默认人格（src/core.js 的 DEFAULT_PERSONA）；填了这段就整段替换 system 提示词。软件版设置页「人格」那一栏也是改这里，保存后重启服务生效。",
  "voice": {
    "enabled": false,
    "voice": "",
    "rate": 0
  },
  "voiceNote": "软件版专用：enabled=true 会朗读她的回复（系统自带 TTS，不联网、不要 key）；voice 留空 = 自动挑中文声音；rate 是语速 -10~10。麦克风听写走系统中文识别，不需要配置。",
  "localModel": {
    "base": "http://127.0.0.1:11434",
    "models": {
      "8b": "qwen3:8b",
      "14b": "qwen3:14b"
    },
    "note": "自适应判定层在 6~13 分区间会问本地小模型一句；model 要写本机实际有的 tag"
  },
  "update": {
    "enabled": false,
    "manifestUrl": "",
    "url": "https://github.com/jingqian-sy/jingqian-single-a/releases"
  },
  "plugins": {
    "enabled": []
  },
  "features": {
    "subagent": true
  },
  "mcp": {
    "enabled": false,
    "servers": []
  }
}